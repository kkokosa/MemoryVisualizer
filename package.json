{
  "name": "memoryvisualizer",
  "version": "0.1.0-dev",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "desktop"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build:desktop": "npm run build --workspace=@memoryvisualizer/desktop",
    "test:protocol": "npm run build:desktop && npm test --workspace=@memoryvisualizer/desktop",
    "electron:install": "node scripts/install-electron.mjs",
    "test:electron": "node scripts/electron-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
